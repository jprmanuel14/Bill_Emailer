<div class="modal fade" id="ModalAddException" tabindex="-1" role="dialog" aria-labelledby="ModalAddException" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 0px;">
            <div class="modal-body py-4 mx-auto" style="width:100%;">
                <form id="SubmitExceptions" method="post" asp-controller="Settings" asp-action="Submit" enctype="multipart/form-data">
                    <div class="px-4">

                        <div class="form-group row">
                            <label asp-for="ClientName">Debtor name</label>
                            <input asp-for="ClientName" type="text" class="form-control" />
                            <span asp-validation-for="ClientName" class="text-danger"></span>
                        </div>
                        <div class="form-group row">
                            <label asp-for="ClientCode">Debtor code</label>
                            <input asp-for="ClientCode" type="text" class="form-control" readonly />
                            <span asp-validation-for="ClientCode" class="text-danger"></span>

                        </div>
                        <div class="form-group row">
                            <label asp-for="Reasons">Reasons</label>
                            <textarea asp-for="Reasons" class="form-control"></textarea>
                            <span asp-validation-for="Reasons" class="text-danger"></span>
                        </div>


                        <div class="d-flex justify-content-end py-2">
                            <input type="submit" class="btn btn-primary-custom" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="ModalShowException" tabindex="-1" role="dialog" aria-labelledby="ModalShowException" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 0px;">
            <div class="modal-body py-4 mx-auto" style="width:100%;">
                    <div class="px-4">
                        <input type="hidden" id="myRefToRemove" />
                        <div class="form-group row">
                            <label>Debtor name</label>
                            <input id="displayClientName" type="text" class="form-control" readonly/>
                        </div>
                        <div class="form-group row">
                            <label>Debtor code</label>
                            <input id="displayCode" type="text" class="form-control" readonly />
                       
                        </div>
                        <div class="form-group row">
                            <label>Reasons</label>
                            <textarea id="displayReason" class="form-control" readonly></textarea>
                        </div>


                        <div class="d-flex justify-content-end py-2">
                            <button class="btn-secondary-custom mr-2" data-dismiss="modal">Close</button>

                            <button class="btn-primary-custom" onclick="return RemoveThis();">Remove</button>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="adminLogsModal" tabindex="-1" role="dialog" aria-labelledby="ModalAddToException" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered d-flex align-items-center justify-content-center col-lg-10" style="max-width: 80%;" role="document">
        <div class="modal-content col-lg-11" style="border-radius: 4px;">
            <div class="modal-body py-4 mx-auto" style="width:100%;">
                <div id="ExceptionContactNameHeader" class="h5 font-weight-bold py-2"></div>
                <input type="hidden" id="ExceptionRefno" />

                <span id='logsLabel' class="my-text-label a-text-orange fw-bold">
                    Admin logs
                </span>



                <div class="col-lg-12 d-flex align-items-center justify-content-between">

                    <div class="d-flex align-items-center searchContainer mt-4 col-lg-4 col-md-6 col-12">
                        <span class="Appkit4-icon icon-search-outline"></span>
                        <input id="searchValActivity" onchange='searchAdminLogs()' type="text" class="form-control w-100 me-2 remove-input-border w-100" placeholder="Search" />

                    </div>

                    <button onclick="downloadLogs()"  id="BtnDownload" class="btn my-primary-button">
                        <span class="Appkit4-icon icon-arrow-down-outline"></span>
                        Download
                    </button>
                </div>



                <div id="clientTable" class="w-100 overflow-auto tableFixHeadC px-3 mt-4 removeScroll" style="max-height: 500px;">
                    <table id="tblmyClients" class="table">
                        <thead>
                            <tr>
                                <th>
                                    Date
                                </th>
                                <th>
                                    Time
                                </th>
                                <th>
                                    Action taker
                                </th>
                                <th>
                                  Action taken
                                </th>



                            </tr>
                        </thead>
                        <tbody id="tblBodyLogs">
                        </tbody>
                        <tfoot id="tblFooterLogs">
                        </tfoot>
                    </table>
                </div>

                <div class="d-flex justify-content-center py-2">
                    <button class="my-primary-button button-padding mr-2" data-bs-dismiss="modal">Close</button>
                </div>

            </div>
        </div>
    </div>
</div>


