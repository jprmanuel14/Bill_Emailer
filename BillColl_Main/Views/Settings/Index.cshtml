                </div>

                    <div class="mt-3">
                    <span>Date added</span>

                    <div class="col-lg-12 mt-1">
                        
                        <input id="dateEdit" disabled value="Test" class="form-control"/>
                    </div>
                </div>

                    <div class="mt-3">
                        <span>Role</span>

                        <div class="col-lg-12 mt-1">

                            <input id="roleEdit" disabled value="Test" class="form-control" />
                        </div>
                    </div>


                <div class="mt-3">
                    <span>Role</span>

                    <div class="form-check mt-2">
                            <input class="form-check-input" type="radio" name="flexRadioDefault" id="editRegularRadio" onchange='selectedRole("editRegularRadio")'>
                        <label class="form-check-label" for="flexRadioDefault1">
                            Regular user
                        </label>
                    </div>
                    <div class="form-check">
                            <input class="form-check-input" type="radio" name="flexRadioDefault" id="editAdminRadio" onchange='selectedRole("editAdminRadio")'>
                        <label class="form-check-label" for="flexRadioDefault2">
                            Admin
                        </label>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end mt-4">
                        <div onclick="closeEditUser()" class="my-secondary-button button-padding">
                        Cancel
                    </div>

                    <button disabled id="updateButton" onclick='updateUserRole()' class="my-primary-button d-flex align-items-center disableBtn justify-content-center button-padding ms-3 disableBtn">
                        Update
                    </button>
                </div>
            </div>
        </div>
    </div>


      

</div>

@section Scripts{

    <environment include="Development">
        <script src="~/js/utilities.js"></script>
    </environment>
    
    <environment exclude="Development">
        <script src="~/js/utilities.js"></script>
    </environment>
}
