@{
    Layout = "_LayoutError";
    ViewData["Title"] = "Error";
}

@*<h1 class="text-danger">Error</h1>
    <h2 class="text-danger">An error occurred while processing your request!</h2>*@


<div class="container w-75 m-auto text-center" style="position:relative; top: 150px;">
    <div style="height: auto;">
        <span style="height: 425px; width: 425px; background-color: #D04A02; border-radius: 50%;display: inline-block;line-height: 400px;color: white;font-size: 252px;">!</span>
    </div>
    <div class="font-weight-bolder py-5" style="font-size:52px; line-height:1;">
        An error occurred while processing your request!
    </div>

    <div class="font-weight-bold py-2" style="font-size:24px">
        Please contact PH GTS or raise a snow ticket for this issue.
    </div>
    <div class="font-weight-bold py-2" style="font-size:24px">
        Please click this link to
        <a asp-action="Index" asp-controller="Account" style="color:white">login</a>
        or to return to your
        <a asp-action="Index" asp-controller="Home" style="color:white">dashboard</a>

    </div>
</div>


