<div class="modal fade" id="stamentModal" tabindex="-1" role="dialog" aria-labelledby="stamentModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered d-flex align-items-center justify-content-center" role="document" style="max-width: 1500px;">
          <div class="modal-content" style="border-radius: 0px; min-height: 600px">

            <div class='p-5'>
                <p>Dear Sir/Ma'am</p>
                <p>
                    We are reaching out to remind you of your outstading invoice(s):
                </p>

                <div class='d-flex align-items-center justify-content-between mt-5'>
                    <span class='fw-bold'>Isla Lipana and Co.</span>
                    <span class='fw-bold'><span>Grand total:</span> 1,0008,000.00</span>
                </div>

                <div class='col-lg-12 d-flex align-items-center justify-content-center mt-3'>

                    <div class='col-lg-6 d-flex align-items-center justify-content-center table-column border-l border-r' style='min-height: 100px'>
                            <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                                <span class='fw-bold'>Invoice date</span>
                            </div>
                        <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                                <span class='fw-bold'>Invoice No.</span>
                            </div>
                        <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                                <span class='fw-bold'>Bill No.</span>
                            </div>
                        <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                                <span class='fw-bold'>No. Age (Days)</span>
                            </div>


                            
                    </div>
                    
                    <div class='col-lg-6 flex-column align-items-center justify-content-center table-column border-l border-r' style='max-height: 100px'>
                            <div class='col-lg-12 p-3 d-flex align-items-center justify-content-center'>
                                <span class='fw-bold'>Outstanding Balance</span>
                            </div>

                            <div style='width: 90%; height:0.5px; background-color: #7E7F7F'>

                            </div>

                                  <div class='col-lg-12 d-flex align-items-center justify-content-center table-column' >
                                        <div class='col-lg-4 p-3 d-flex align-items-center justify-content-center'>
                                            <span class='fw-bold'>Other Currency Code</span>
                                        </div>
                                        <div class='col-lg-4 p-3 d-flex align-items-center justify-content-center'>
                                            <span class='fw-bold'>Amount in Other Currency</span>
                                        </div>
                                        <div class='col-lg-4 p-3 d-flex align-items-center justify-content-center'>
                                            <span class='fw-bold'>Amount in Peso</span>
                                        </div>
                            
                                  </div>
                            
                    </div>

                </div>

                @*Items*@

                <div class='col-lg-12 d-flex align-items-center justify-content-center'>

                    <div class='col-lg-6 d-flex align-items-center justify-content-center border-bottom border-r border-l' style='min-height: 100px'>
                        <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                            <span class='fw-bold'>Invoice date</span>
                        </div>
                        <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                            <span class='fw-bold'>Invoice No.</span>
                        </div>
                        <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                            <span class='fw-bold'>Bill No.</span>
                        </div>
                        <div class='col-lg-3 p-3 d-flex align-items-center justify-content-center'>
                            <span class='fw-bold'>No. Age (Days)</span>
                        </div>
                    </div>

                    <div class='col-lg-6 d-flex align-items-center justify-content-center border-bottom border-l border-r' style='min-height: 100px'>

                        <div class='col-lg-4 p-3 d-flex align-items-center justify-content-center'>
                            <span class='fw-bold'>Invoice date</span>
                        </div>
                        <div class='col-lg-4 p-3 d-flex align-items-center justify-content-center'>
                            <span class='fw-bold'>Invoice No.</span>
                        </div>
                        <div class='col-lg-4 p-3 d-flex align-items-center justify-content-center'>
                            <span class='fw-bold'>Bill No.</span>
                        </div>

                    </div>

                </div>

            </div>

          </div>
    </div>
</div>

