                                <span id="ctrU" class="ml-1"></span>
                            </button>
                            <button id="DeliveredPbtn" class=" btn-sp my-btn btn-side-panel-deactive-2 w-50 mt-2" style="border-radius:0;" onclick="return openTab('DeliveredP');">
                                Delivered
