                            </button>
                        </div>
                    </div>
                    <div class="col-7">
                        <div class="col-lg-12 d-flex justify-content-end align-items-center px-4">
                            @*<div class="d-flex align-items-center">
                                    <label class="font-weight-light check-label-custom mr-2" style="height:8px;">
                                        <input class="mr-2" name="chkSearchAllDates" type="checkbox" />
