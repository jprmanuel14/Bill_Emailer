@model LoginViewModel
@{
    ViewData["Title"] = "Development Login";
    Layout = "_LayoutDenied";
}

<div class="container w-75 m-auto text-center" style="position:relative; top: 120px;">
    <div class="font-weight-bolder py-4" style="font-size:40px">
        Development Login
    </div>

    <div class="font-weight-bold py-2" style="font-size:20px">
        Single Sign-On is disabled. Sign in with the local development account.
    </div>

    <div class="d-flex justify-content-center py-4">
        <form asp-action="LoginManual" asp-controller="Account" method="post" class="w-100">
            <div class="form-group text-left">
                <label asp-for="Username" class="font-weight-bold">Email</label>
                <input asp-for="Username" type="text" class="form-control" placeholder="Email address" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <button type="submit" class="btn px-4">Sign in</button>
        </form>
    </div>
</div>
