                </div>


            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalAddNewContacts" tabindex="-1" role="dialog" aria-labelledby="ModalAddNewContacts" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 0px;">
            <div class="modal-body py-4 mx-auto" style="width:100%;">
                <form id="SubmitContacts" method="post" asp-controller="Clients" asp-action="Submit" enctype="multipart/form-data">
                    <div class="px-4">
                        <input type="hidden" asp-for="eId" />
                        <input type="hidden" asp-for="eClientCode" />
                        <input type="hidden" asp-for="pageNumber" />
                        <input type="hidden" asp-for="pageSize" />
                        <input type="hidden" asp-for="SearchText" />


                        <div class="d-flex">
                            <div class="form-check form-check-inline">
                                <label class="form-check-label check-label-custom">
                                    Client
                                    <input class="form-check-input" type="radio" asp-for="IsEngagement" value="False" id="rdClient" onclick="CheckValue(this);">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <label class="form-check-label check-label-custom">
                                    Engagement
                                    <input class="form-check-input" type="radio" asp-for="IsEngagement" value="True" id="rdEngagement" onclick="CheckValue(this);">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                            <span asp-validation-for="IsEngagement" class="text-danger"></span>
                        </div>

                        <div class="EngagementP d-none my-1">
                            <div class="form-group row">
                                <label asp-for="Name">Name</label>
                                <input asp-for="Name" type="text" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>

                        <div id="ClientP" class="d-none my-1">
                            <div class="form-group row">
                                <label asp-for="FirstName">First name</label>
                                <input asp-for="FirstName" type="text" onch class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>

                                <label asp-for="MiddleName">Middle name</label>
                                <input asp-for="MiddleName" type="text" class="form-control" />
                                <span asp-validation-for="MiddleName" class="text-danger"></span>

                                <label asp-for="LastName">Last name</label>
                                <input asp-for="LastName" type="text" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>

                                <label asp-for="Salutation">Salutation</label>
                                <input asp-for="Salutation" type="text" class="form-control" />

                            </div>
                        </div>


                        <div class="form-group row">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" type="text" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>

                        </div>
                        <div class="form-group row">
                            <label asp-for="ContactNumber">Contact number</label>
                            <input asp-for="ContactNumber" type="text" class="form-control" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>
                        <div class="form-group row">
                            <label asp-for="Designation">Designation</label>
                            <input asp-for="Designation" type="text" class="form-control" />
                            <span asp-validation-for="Designation" class="text-danger"></span>
                        </div>


                        <div class="EngagementP d-none my-1">
                            <div class="form-group row">
                                <label asp-for="GroupName">Group</label>
                                <select class="selectize-control w-100" asp-for="GroupName" placeholder="Select group">
                                    <option value=""></option>
                                    @if (Model.Groups.Count() != 0)
                                    {
                                        for (int i = 0; i < Model.Groups.Count(); i++)
                                        {
                                            <option value="@Model.Groups[i].Description">@Model.Groups[i].Description</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end py-2">
                            <button class="btn-secondary-custom mr-2" data-dismiss="modal">Cancel</button>
                            <input type="submit" class="btn btn-primary-custom" onclick="return ClearDisable();" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addUserModal" tabindex="-1" role="dialog" aria-labelledby="ModalAddToException" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: none; display: flex; justify-content: center" role="document">
        <div class="modal-content" style="width: 50%">
            <div class="modal-body p-5 mx-auto" style="width:100%;">
                <h4 class="a-text-orange">
                    Add client contact
                </h4>

                <div class="mt-3">
                    <span>
                        Search an employee to fill out the details below
                    </span>
                </div>

                <div class="mt-3">
                    <span>First name <span style="color: red; font-weight: bold; margin-left: 5px">*</span></span>
                    <input class="form-control mt-2" id="FnameInput" onchange='FirstNameUpdate()' placeholder="">
                </div>

                <div class="mt-3 d-none">
                    <span>Middle name</span>
                    <input class="form-control mt-2" id="MnameInput" onchange='MiddleNameUpdate()' placeholder="">
                </div>

                <div class="mt-3">
                    <span>Last name <span style="color: red; font-weight: bold; margin-left: 5px">*</span></span>
                    <input class="form-control mt-2" id="LnameInput" onchange='LastNameUpdate()' placeholder="">
                </div>


                <div class="mt-3">
                    <span>Contact number</span>
                    <input class="form-control mt-2" id="ContactNumberInput" onchange='ContactNumberUpdate()' placeholder="">
                </div>

                <div class="mt-3">
                    <span>Salutation</span>
                    <input class="form-control mt-2" id="salutationInput" onchange='salutationUpdate()' placeholder="">
                </div>

                <div class="mt-3">
                    <div class="d-flex justify-content-between">
                        <span>Email <span style="color: red; font-weight: bold; margin-left: 5px">*</span></span>

                        <span id="emailInvalidLabel" class="a-text-red invalidInput d-none">invalid email address</span>
                    </div>
                    <div class="d-flex position-relative">

                        <input type="email" class="form-control mt-2" id="emailInput" onchange="emailUpdate()" aria-describedby="emailHelp" placeholder="">

                        <div id="invalidIcon" class="position-absolute end-0 me-2 d-none" style="margin-top: 20px;">
                            <span class="Appkit4-icon icon-circle-delete-fill a-text-red"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <span>Designation</span>
                    <input class="form-control mt-2" id="designationInput" onchange="designationUpdate()" placeholder="">
                </div>


                <div class="mt-3">
                    <span>Select group <span style="color: red; font-weight: bold; margin-left: 5px">*</span></span>
                </div>
                <div id="groupContainer" class="dropdown-content mt-2 col-lg-12">

                    <input type="text" onblur="removeFocusInput('groupList')" onfocus='focusInput("groupList")' placeholder="Select group" id="myInput" onkeyup="filterFunction('myInput', 'groupList')">

                    <div id="groupList" class="customDropDown myBoxShadow" style="width: 90%">
                    </div>
                </div>


                @*  <div class="mt-3 d-flex flex-column">
                <span>Designated group <span class="a-text-red">*</span></span>

