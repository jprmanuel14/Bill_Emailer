                <div class="row w-100 ml-1" style="border-bottom: 2px solid #D04A02;">
                    <div class="col-8">
                        <div class="d-flex">
                            <button id="cContactsbtn" class="btn btn-sp btn-primary-custom w-50 mt-2" style="border-radius:0;" onclick="return openTab('cContacts');">
                                Client contacts
                                <span id="ctrU" class="ml-1"></span>
                            </button>
                            <button id="eContactsbtn" class="btn btn-sp btn-primary-custom btn-side-panel-deactive-2 w-50 mt-2" style="border-radius:0;" onclick="return openTab('eContacts');">
                                Engagement team
                            </button>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="d-flex justify-content-end align-items-center px-4">
                            <button id="BtnAddContact" class="btn btn-primary-custom" style="width:150px;">Add contact</button>
                        </div>
                    </div>
                </div>

                <div class="row mx-1">
                    <div id="cContacts" class="mt-3 w-100 sidebarTab">
                        <div class="w-100 overflow-auto tableFixHeadCC px-2" style="max-height: 500px; min-height: 500px;">
                            <table id="tblmycContacts" class="table">
                                <thead>
                                    <tr>
                                        <th>Contact email</th>
                                        <th>Contact number</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tblBodyCContacts">
                                </tbody>
                                <tfoot id="tblFooterCContacts">
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div id="eContacts" class="mt-3 w-100 sidebarTab" style="display:none;">
                        <div class="w-100 overflow-auto tableFixHeadEC px-2" style="max-height: 500px; min-height: 500px;">
                            <table id="tblmyeContacts" class="table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Contact email</th>
                                        <th>Contact number</th>
                                        <th>Designation</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tblBodyEContacts">
                                </tbody>
                                <tfoot id="tblFooterEContacts">
                                </tfoot>
